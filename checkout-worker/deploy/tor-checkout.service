# /etc/systemd/system/tor-checkout.service
# Temples of Refuge — Stripe checkout backend (Node) behind Caddy, localhost-bound.
# Modeled on ../../work.agualila.earth/infra/work-agualila.service.
#
# The code ships inside the templesofrefuge site clone, so it deploys with the
# site's normal `git pull` — no separate rsync. No DB; the one writable path is
# the StateDirectory below, which holds private design-poll votes
# (src/poll-store.js). Config/secrets come from /etc/tor-checkout/env.

[Unit]
Description=Temples of Refuge — Stripe checkout backend (Node)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Throwaway system user managed by systemd — no useradd/group needed. systemd
# reads EnvironmentFile as root before dropping privileges, so the secret file
# stays root-only and the service still runs unprivileged.
DynamicUser=yes
WorkingDirectory=/var/www/templesofrefuge/checkout-worker
ExecStart=/usr/bin/node /var/www/templesofrefuge/checkout-worker/src/node-server.js
EnvironmentFile=/etc/tor-checkout/env
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# /var/lib/tor-checkout, owned by the DynamicUser and passed as $STATE_DIRECTORY.
# The only path ProtectSystem=strict leaves writable.
StateDirectory=tor-checkout
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
