# Copied to /etc/tor-checkout/env on the box (chown root:torcheck, chmod 640).
# Never commit the real file — this example holds placeholders only.

# Your LIVE Stripe secret key (Dashboard → Test mode OFF → Developers → API keys).
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_LIVE_SECRET_KEY

# Origins allowed to call this endpoint (the sites that render the offering).
ALLOWED_ORIGINS=https://templesofrefuge.earth,https://www.templesofrefuge.earth,https://syncengine.earth,https://www.syncengine.earth,https://agualila.earth,https://www.agualila.earth

# The LIVE Stripe product each offering is recorded against.
PRODUCT_ID=prod_UqVlyjujBeFQMX

# Localhost bind — Caddy terminates TLS and proxies to this.
PORT=8787
HOST=127.0.0.1
