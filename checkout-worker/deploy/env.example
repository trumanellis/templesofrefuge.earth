# Copied to /etc/tor-checkout/env on the box (chown root:torcheck, chmod 640).
# Never commit the real file — this example holds placeholders only.

# Your LIVE Stripe secret key (Dashboard → Test mode OFF → Developers → API keys).
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_LIVE_SECRET_KEY

# Origins allowed to call this endpoint (the sites that render the offering).
#
# agualila.earth is deliberately ABSENT. A donation session opened from a
# Portuguese-branded domain into the US charity's Stripe account is the conduit
# appearance Rev. Rul. 63-252 punishes — Temples of Refuge must retain complete
# control and discretion over donated funds, and must never look like a
# pass-through to a foreign project. That site describes the place and the
# practice; it does not solicit. Do not add it back.
ALLOWED_ORIGINS=https://templesofrefuge.earth,https://www.templesofrefuge.earth,https://templesof.earth,https://www.templesof.earth,https://syncengine.earth,https://www.syncengine.earth

# The LIVE Stripe product each offering is recorded against.
PRODUCT_ID=prod_UqVlyjujBeFQMX

# Localhost bind — Caddy terminates TLS and proxies to this.
PORT=8787
HOST=127.0.0.1

# ── Form intake (/inquiry) — Migadu SMTP ──────────────────────────────────
#
# Relays the found-a-temple declaration and any other site form to INQUIRY_TO.
# Nothing is stored; the mail is the only copy.
#
# Migadu rather than a transactional API on purpose:
#   • SPF for templesofrefuge.earth is `v=spf1 include:spf.migadu.com -all`.
#     That `-all` is a hard fail, so mail sent straight from this box would be
#     rejected downstream. Migadu is already authorised.
#   • Declarations carry religious belief (GDPR Article 9). Migadu is Swiss with
#     European infrastructure, so the content stays in the EU/EEA and no new
#     processor is introduced.
#
# Credentials: Migadu admin → Mailboxes → the sending mailbox → password.
# Prefer a dedicated mailbox (e.g. noreply@) over a human's, so rotating it
# never locks a person out of their own mail.
#
# ALL FOUR of SMTP_HOST / SMTP_USER / SMTP_PASS / INQUIRY_TO must be set or
# /inquiry returns 503 and the site's forms fall back to a mailto: link. The
# service still starts — checkout must not depend on mail being configured.
SMTP_HOST=smtp.migadu.com
SMTP_PORT=465
SMTP_USER=noreply@templesofrefuge.earth
SMTP_PASS=REPLACE_WITH_MIGADU_MAILBOX_PASSWORD
SMTP_FROM=Temples of Earth <noreply@templesofrefuge.earth>
INQUIRY_TO=ola@templesofrefuge.earth
