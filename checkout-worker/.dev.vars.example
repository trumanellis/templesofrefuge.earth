# Local development secrets for `wrangler dev`.
# Copy this file to `.dev.vars` (which is gitignored) and paste your TEST-mode
# Stripe secret key. Get it from: Stripe Dashboard → toggle "Test mode" →
# Developers → API keys → Secret key (starts with sk_test_).
#
#   cp .dev.vars.example .dev.vars
#   # then edit .dev.vars and paste your key
#
STRIPE_SECRET_KEY=sk_test_paste_your_test_secret_key_here
