# PROPOSAL — not applied. Replaces the single four-name block in
# infra/Caddyfile when phase C of plans/SITE-SPLIT.md is reached.
#
# One checkout on disk, two roots. Temples of Earth keeps the repo root.
# Temples of Refuge serves refuge/, and borrows the shared brand files from
# the parent. There is no second deploy target.

# ── Temples of Earth ────────────────────────────────────────────────
templesof.earth, www.templesof.earth {
	encode zstd gzip
	# header { … }   ← keep the existing header block, CSP included, as is.

	handle /_deploy {
		reverse_proxy 127.0.0.1:9000
	}
	handle {
		root * /var/www/templesofrefuge
		route {
			@markdown path_regexp md (?i)\.md$
			respond @markdown 404

			# The Refuge root must not answer on this domain.
			@refugeroot path /refuge /refuge/*
			redir @refugeroot https://templesofrefuge.earth/ 301

			# Pages that moved to Temples of Refuge.
			redir /cosmology        https://templesofrefuge.earth/cosmology 301
			redir /bylaws           https://templesofrefuge.earth/charter 301
			redir /found-a-temple   https://templesofrefuge.earth/found-a-temple 301

			# … existing /ceremony-mats, index.html and .html rules unchanged …

			try_files {path} {path}.html {path}/index.html
			file_server
		}
	}
}

# ── Temples of Refuge ───────────────────────────────────────────────
templesofrefuge.earth, www.templesofrefuge.earth {
	encode zstd gzip
	header {
		?Cache-Control "public, max-age=3600"
		# No Stripe, no third-party frames: this site has no checkout, and the
		# policy says so. connect-src keeps only the inquiry endpoint used by
		# the Found a Temple declaration.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' https://checkout.templesofrefuge.earth https://checkout.templesof.earth; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
	}

	handle /_deploy {
		reverse_proxy 127.0.0.1:9000
	}

	# Shared brand files come from the parent root.
	@shared path /shared/* /assets/* /favicon.ico /favicon-*.png /apple-touch-icon.png /site.webmanifest
	handle @shared {
		root * /var/www/templesofrefuge
		file_server
	}

	handle {
		root * /var/www/templesofrefuge/refuge
		route {
			@markdown path_regexp md (?i)\.md$
			respond @markdown 404

			# Pages that live on Temples of Earth. Old links and printed QR
			# codes keep working. CHECK which domain the mat QR prints before
			# relying on the /mats rule (SITE-SPLIT §6.4).
			redir /mats              https://templesof.earth/mats 301
			redir /ceremony-mats     https://templesof.earth/mats 301
			redir /join              https://templesof.earth/join 301
			redir /covenant          https://templesof.earth/covenant 301
			redir /coherence-engine  https://templesof.earth/coherence-engine 301
			redir /articles/*        https://templesof.earth{uri} 301
			redir /bylaws            /charter 301

			@indexhtml path_regexp idx ^(.*/)?index\.html$
			redir @indexhtml {re.idx.1} 301
			@htmlnq path_regexp oldhtml2 ^/(.*)\.html$
			redir @htmlnq /{re.oldhtml2.1} 301

			try_files {path} {path}.html {path}/index.html
			file_server
		}
	}
}
