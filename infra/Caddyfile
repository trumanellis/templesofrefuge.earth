# /etc/caddy/Caddyfile
# Serves both static sites with automatic HTTPS (Let's Encrypt).
# Caddy provisions a certificate per hostname once DNS points at this box.

templesofrefuge.earth, www.templesofrefuge.earth {
	root * /var/www/templesofrefuge
	file_server
	encode zstd gzip

	# Static-site niceties
	header {
		# modest caching for assets; HTML stays fresh
		?Cache-Control "public, max-age=3600"
	}
}

syncengine.earth, www.syncengine.earth {
	root * /var/www/syncengine
	file_server
	encode zstd gzip

	header {
		?Cache-Control "public, max-age=3600"
	}
}

agualila.earth, www.agualila.earth {
	root * /var/www/agualila
	file_server
	encode zstd gzip

	header {
		?Cache-Control "public, max-age=3600"
	}
}

# Work tracker — Node/Fastify app (see ../work.agualila.earth), bound to
# localhost:3200 by the work-agualila systemd service. Caddy terminates TLS
# and proxies; the app never binds a public port.
work.agualila.earth {
	reverse_proxy 127.0.0.1:3200
}

# Temples of Refuge — Stripe checkout backend (Node/self-hosted). Bound to
# localhost:8787 by the tor-checkout systemd service; Caddy terminates TLS and
# proxies. Serves every origin in the service's ALLOWED_ORIGINS.
checkout.templesofrefuge.earth {
	reverse_proxy 127.0.0.1:8787
}

# Indra's Network — donation gateway (Rust, indras-donation-gateway in the
# agent1 repo). Turns a paid Stripe session into a one-shot founding-gift code
# the app redeems at first launch. Bound to localhost:8788 by its systemd
# service; claims ledger persists in /var/lib/indras-donation-gateway.
api.templesofrefuge.earth {
	reverse_proxy 127.0.0.1:8788
}

