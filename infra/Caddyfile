# /etc/caddy/Caddyfile
# Serves the sibling static sites with automatic HTTPS (Let's Encrypt).
# Caddy provisions a certificate per hostname once DNS points at this box.
#
# Each static site uses the handle{} form (not a bare file_server) so the
# `/_deploy` auto-deploy hook can sit alongside the file server: POST /_deploy
# is reverse-proxied to the webhook-deploy service (127.0.0.1:9000), which
# git-pulls the matching /var/www checkout (routed by Host). All three sites
# are registered in /etc/webhook-deploy/sites.json. See
# syncengine.earth/deploy/README.md.
#
# IMPORTANT: keep the /_deploy handlers when editing — removing them silently
# breaks push-to-deploy for that site.

# Temples of Refuge is mid-migration from templesofrefuge.earth to the shorter
# templesof.earth. Both names are listed on ONE site block on purpose: they are
# the same checkout on disk, so the two domains cannot drift apart and there is
# no second deploy target to keep in sync. Caddy issues a single cert covering
# all four names.
#
# The pages declare templesof.earth canonical (see <link rel="canonical">), so
# search engines consolidate onto the new domain while every old URL keeps
# answering 200. When the transition is done, cut templesofrefuge.earth out of
# this list and give it its own block that 301s to templesof.earth — do NOT do
# that until the new domain has been indexed, or you strand the existing links.
templesofrefuge.earth, www.templesofrefuge.earth, templesof.earth, www.templesof.earth {
	encode zstd gzip
	header {
		?Cache-Control "public, max-age=3600"

		# Stripe.js leans on a CSP for its XSS protections, and we had none.
		#
		# REPORT-ONLY ON PURPOSE. This block serves the live donation path; an
		# over-tight policy would break Stripe's embedded checkout iframes
		# quietly, and a donor hitting a dead /join is worse than a missing
		# header. Load /join and /mats, run a test-mode checkout, confirm the
		# console logs no violations, then rename this header to
		# `Content-Security-Policy` to enforce it.
		#
		# 'unsafe-inline' is unavoidable here: these are static HTML files with
		# ~19 inline <script> and ~10 <style> blocks, and nonces need
		# server-side templating. So this is a HOST ALLOWLIST — it constrains
		# where scripts, frames and fetches may come from — not full XSS
		# protection. Removing the inline scripts is what would earn that.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://substackcdn.com https://*.substack.com; frame-src https://*.stripe.com https://*.stripe.network https://aeonmyths.substack.com; connect-src 'self' https://*.stripe.com https://*.stripe.network https://checkout.templesof.earth https://api.templesof.earth https://checkout.templesofrefuge.earth https://api.templesofrefuge.earth https://api.web3forms.com https://api.github.com https://raw.githubusercontent.com; form-action 'self' https://*.stripe.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
	}

	handle /_deploy {
		reverse_proxy 127.0.0.1:9000
	}
	handle {
		root * /var/www/templesofrefuge
		route {
			# The Ceremony Mat page is /mats on disk (mats.html) — the short
			# URL printed on the QR / posters is now the real one, not a
			# rewrite. Its former path keeps answering so already-shared
			# links and anything indexed survive. Two matchers so a
			# query-less URL does not pick up a trailing "?" — same reason
			# as the .html rules below. Must come before those rules, or
			# /ceremony-mats.html bounces through /ceremony-mats first.
			@matsq {
				path /ceremony-mats /ceremony-mats.html
				expression {query} != ""
			}
			redir @matsq /mats?{query} 301
			@matsnq {
				path /ceremony-mats /ceremony-mats.html
				expression {query} == ""
			}
			redir @matsnq /mats 301

			# /index.html -> /  and  /articles/index.html -> /articles/
			@indexhtml path_regexp idx ^(.*/)?index\.html$
			redir @indexhtml {re.idx.1} 301

			# /join.html -> /join (two matchers so a query-less URL
			# does not pick up a trailing "?")
			@htmlq {
				path_regexp oldhtml ^/(.*)\.html$
				expression {query} != ""
			}
			redir @htmlq /{re.oldhtml.1}?{query} 301
			@htmlnq {
				path_regexp oldhtml2 ^/(.*)\.html$
				expression {query} == ""
			}
			redir @htmlnq /{re.oldhtml2.1} 301

			# /join -> join.html on disk
			try_files {path} {path}.html {path}/index.html
			file_server
		}
	}
}

syncengine.earth, www.syncengine.earth {
	encode zstd gzip
	header {
		?Cache-Control "public, max-age=3600"
	}

	handle /_deploy {
		reverse_proxy 127.0.0.1:9000
	}

	# App downloads (the .dmg/.apk + pick-your-platform page). Served from a
	# non-git dir so the large binaries stay out of the repo and auto-deploy.
	# DOWNLOAD_ARTIFACT_URL (donation gateway) points at https://syncengine.earth/get/.
	redir /get /get/
	handle_path /get/* {
		root * /var/www/downloads
		file_server
	}

	handle {
		root * /var/www/syncengine
		route {
			# /index.html -> /  and  /articles/index.html -> /articles/
			@indexhtml path_regexp idx ^(.*/)?index\.html$
			redir @indexhtml {re.idx.1} 301

			# /join.html -> /join (two matchers so a query-less URL
			# does not pick up a trailing "?")
			@htmlq {
				path_regexp oldhtml ^/(.*)\.html$
				expression {query} != ""
			}
			redir @htmlq /{re.oldhtml.1}?{query} 301
			@htmlnq {
				path_regexp oldhtml2 ^/(.*)\.html$
				expression {query} == ""
			}
			redir @htmlnq /{re.oldhtml2.1} 301

			# /join -> join.html on disk
			try_files {path} {path}.html {path}/index.html
			file_server
		}
	}
}

agualila.earth, www.agualila.earth {
	encode zstd gzip
	header {
		?Cache-Control "public, max-age=3600"
	}

	handle /_deploy {
		reverse_proxy 127.0.0.1:9000
	}
	handle {
		root * /var/www/agualila
		route {
			# Same extensionless scheme as the sibling sites. Agua Lila is a
			# single page today, so this earns exactly one thing right now:
			# /index.html stops serving a duplicate of / and 301s to it. The
			# try_files line is dormant until there is a second page, at which
			# point it gets clean URLs without anyone rediscovering this.
			@indexhtml path_regexp idx ^(.*/)?index\.html$
			redir @indexhtml {re.idx.1} 301

			@htmlq {
				path_regexp oldhtml ^/(.*)\.html$
				expression {query} != ""
			}
			redir @htmlq /{re.oldhtml.1}?{query} 301
			@htmlnq {
				path_regexp oldhtml2 ^/(.*)\.html$
				expression {query} == ""
			}
			redir @htmlnq /{re.oldhtml2.1} 301

			try_files {path} {path}.html {path}/index.html
			file_server
		}
	}
}

# Work tracker — Node/Fastify app, bound to localhost:3200 by the work-agualila
# systemd service. Caddy terminates TLS and proxies; the app never binds public.
work.agualila.earth {
	reverse_proxy 127.0.0.1:3200
}

# Temples of Refuge — Stripe checkout backend (Node/self-hosted). Bound to
# localhost:8787 by the tor-checkout systemd service; Caddy terminates TLS and
# proxies. Serves every origin in the service's ALLOWED_ORIGINS.
# checkout.templesof.earth is the new-domain alias; both names hit the same
# service. Every origin the pages are served from must ALSO be listed in the
# service's ALLOWED_ORIGINS (/etc/tor-checkout/env) or the browser's CORS
# preflight fails and the page silently falls back to the hosted Stripe link.
checkout.templesofrefuge.earth, checkout.templesof.earth {
	reverse_proxy 127.0.0.1:8787
}

# Indra's Network — donation gateway (Rust, indras-donation-gateway in the
# agent1 repo). Turns a paid Stripe session into a one-shot founding-gift code
# the app redeems at first launch. Bound to localhost:8788 by its systemd
# service; claims ledger persists in /var/lib/indras-donation-gateway.
api.templesofrefuge.earth, api.templesof.earth {
	reverse_proxy 127.0.0.1:8788
}

